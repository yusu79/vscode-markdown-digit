{
  "private": true,
  "name": "markdown-digit",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.1.0",
  "publisher": "yusu79",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yusu79/vscode-markdown-digit.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "markdownDigit.locale": {
          "type": "string",
          "enum": [
            "",
            "en",
            "in",
            "jp",
            "cn",
            "kr",
            "tw"
          ],
          "enumDescriptions": [
            "%configuration.locale.disabled%",
            "%configuration.locale.en%",
            "%configuration.locale.in%",
            "%configuration.locale.jp%",
            "%configuration.locale.cn%",
            "%configuration.locale.kr%",
            "%configuration.locale.tw%"
          ],
          "default": "",
          "description": "%configuration.locale.description%"
        },
        "markdownDigit.minDigits": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "%configuration.minDigits.description%"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "eslint": "^9.39.3",
    "markdown-it": "^15.0.1",
    "ovsx": "1.1.1"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "markdown-it-digit": "^1.1.0"
  }
}
